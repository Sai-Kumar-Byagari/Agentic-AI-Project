# Environment Configuration for Agentic AI Platform - Frontend

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Development Mode - Use Mock Data
VITE_USE_MOCK_DATA=true

# Encryption Configuration (Optional)
# VITE_ENCRYPTION_KEY=hex_key_here_for_aes_gcm

# Okta SSO Configuration (Optional)
# VITE_OKTA_TENANT_URL=https://your-tenant.okta.com
# VITE_OKTA_CLIENT_ID=your_client_id
# VITE_OKTA_REDIRECT_URI=http://localhost:5173/auth/callback

# Feature Flags (Future Use)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_FEATURE_FLAGS=false

# Logging Configuration
# VITE_LOG_LEVEL=debug
# VITE_ENABLE_REMOTE_LOGGING=true

# Application Environment
# VITE_APP_ENV=development
# VITE_APP_NAME=Agentic AI Platform
# VITE_APP_VERSION=1.0.0

# Notes:
# - Development mode (VITE_USE_MOCK_DATA=true) uses hardcoded mock responses
# - All VITE_ prefixed variables are available in the browser as import.meta.env.VITE_*
# - Never commit sensitive values to version control
# - For production, use environment variable injection or CI/CD secrets
